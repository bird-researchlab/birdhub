# ============================================
# BirdHub - HTTP Caching & Performance Rules
# ============================================

# Enable mod_expires for cache control
<IfModule mod_expires.c>
    ExpiresActive On

    # Fontlar: 1 yıl (hiç değişmiyor)
    ExpiresByType font/ttf                      "access plus 1 year"
    ExpiresByType font/truetype                 "access plus 1 year"
    ExpiresByType application/font-sfnt         "access plus 1 year"

    # Görseller: 1 ay
    ExpiresByType image/png                     "access plus 1 month"
    ExpiresByType image/jpeg                    "access plus 1 month"
    ExpiresByType image/webp                    "access plus 1 month"

    # Sesler: 1 ay
    ExpiresByType audio/mpeg                    "access plus 1 month"
    ExpiresByType audio/mp3                     "access plus 1 month"

    # Video: 1 ay
    ExpiresByType video/mp4                     "access plus 1 month"

    # PHP/HTML: her zaman yeniden doğrula
    ExpiresByType text/html                     "access plus 0 seconds"
</IfModule>

# Cache-Control header'ları
<IfModule mod_headers.c>
    # Statik asset'ler için immutable cache
    <FilesMatch "\.(ttf|png|jpg|jpeg|mp3|mp4|webp)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # PHP: no-cache
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Gzip sıkıştırma (küçük dosyalar için)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ============================================
# Erişim Kısıtlamaları (güvenlik)
# ============================================

# Klasör içeriklerinin listelenmesini kapat (assets/, kayıt/ vb.)
Options -Indexes

# Not/bilgi dosyaları, arşivler ve gizli dosyalar dışarıdan açılamasın
<FilesMatch "(\.(txt|md|zip|bak|log|ini|sh)$|^\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Yedek kayıtlar internetten doğrudan açılamaz; yalnızca ses.php diskten okuyup sunar
    RewriteRule ^assets/data/yedek(/|$) - [F,L,NC]

    # assets/: sadece sitenin kendi sayfalarından gelen isteklere izin ver.
    # Adres çubuğuna doğrudan yazılan veya başka sitelerden gelen istekler 403.
    # (favicon hariç — tarayıcılar onu Referer göndermeden isteyebilir)
    RewriteCond %{REQUEST_URI} !/assets/ui/intro/birdhub_logo\.png$
    RewriteCond %{HTTP_HOST}@@%{HTTP_REFERER} !^([^@:]*)(:\d+)?@@https?://\1(:\d+)?/ [NC]
    RewriteRule ^assets/ - [F,L]
</IfModule>

# ============================================
# Tek ağ geçidi: dışarıdan sadece ses.php çalışır (yönetim sayfası da ses.php?yonetim).
# audio-proxy.php dahil diğer tüm .php dosyaları kapalıdır.
# Durum/log dosyası (.ses-veri.json) nokta ile başladığı için yukarıdaki kuralla kapalıdır.
# ============================================
<FilesMatch "^(?!ses\.php$).+\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
